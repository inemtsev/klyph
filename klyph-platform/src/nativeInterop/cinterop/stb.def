headers = stb_image.h
headerFilter = stb_image.h
# Include path comes from build.gradle.kts (src/nativeInterop/c/stb). The C section below compiles
# the implementation into the interop stubs, so nothing else needs to be built or linked.
# Failure strings stay on: Image.decode puts stbi_failure_reason() into its exception message.
compilerOpts = -DSTBI_ONLY_PNG -DSTBI_ONLY_JPEG -DSTBI_NO_STDIO
package = stb

---

#define STB_IMAGE_IMPLEMENTATION
#include "stb_image.h"
